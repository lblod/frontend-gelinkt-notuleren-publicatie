<section class="au-o-region-large">
  <div class="au-o-layout">
    <AuHeading class="au-u-margin-bottom">Contact</AuHeading>
    <form class="au-c-form js-formvalidation-bound">
      <AuLabel for="select">Waar gaat uw bericht over?</AuLabel>
      <ul>
        <li>
          <AuRadio
            @value="GelinktNotuleren@vlaanderen.be?subject=Functionaliteit of bug of probleem"
            @name="type-vraag"
            @onChange={{fn (mut this.mailto)}}
          >
            Een functionaliteit, bug of probleem
          </AuRadio>
        </li>
        <li>
          <AuRadio
            @name="type-vraag"
            @value="GelinktNotuleren@vlaanderen.be?subject=Inhoudelijke vraag"
            @onChange={{fn (mut this.mailto)}}
          >
            Een inhoudelijke vraag
          </AuRadio>
        </li>
      </ul>

      {{#if this.mailto}}
        <a href={{concat "mailto:" this.mailto}} class="au-c-button">Bericht
          versturen</a>
      {{else}}
        <AuButton @disabled="true">Bericht versturen</AuButton>
      {{/if}}
    </form>
    <AuContent class="au-u-margin-top-small">
      <p>
        Of neem rechtstreeks contact op via mail
        <a
          href="mailto:gelinktnotuleren@vlaanderen.be"
          class="au-c-link"
        >GelinktNotuleren@vlaanderen.be</a>.
      </p>
    </AuContent>
  </div>
</section>
<Footer />