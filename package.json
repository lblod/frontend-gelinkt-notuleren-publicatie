{
  "name": "frontend-gelinkt-notuleren-publicatie",
  "version": "1.7.4",
  "private": true,
  "description": "Publication pages of gelinkt notuleren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lblod/frontend-gelinkt-notuleren-publicatie.git"
  },
  "license": "MIT",
  "author": "redpencil.io",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "dev": "ember serve --proxy https://publicatie.gelinkt-notuleren.vlaanderen.be/",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "ember serve",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\"",
    "test:ember": "ember test",
    "release": "release-it"
  },
  "fastbootDependencies": [
    "date-fns",
    "crypto",
    "node-fetch"
